{
  "manifest_version": 3,
  "name": "e3mel Business Downloader",
  "version": "2.2.0",
  "description": "تحميل فيديوهات دورات e3melbusiness.com بضغطة زر",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "cookies",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "https://www.e3melbusiness.com/*",
    "https://videos.sproutvideo.com/*",
    "https://hls2.videos.sproutvideo.com/*",
    "https://d1ajyp3swh7ygp.cloudfront.net/*",
    "http://fi7.bot-hosting.net:22361/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.e3melbusiness.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/hls.min.js"
      ],
      "matches": [
        "https://www.e3melbusiness.com/*",
        "https://videos.sproutvideo.com/*"
      ]
    }
  ]
}
