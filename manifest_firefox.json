{
  "manifest_version": 2,
  "name": "e3mel Business Downloader",
  "version": "2.2.0",
  "description": "Download videos from e3melbusiness.com courses",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "cookies",
    "windows",
    "https://www.e3melbusiness.com/*",
    "https://videos.sproutvideo.com/*",
    "https://hls2.videos.sproutvideo.com/*",
    "https://d1ajyp3swh7ygp.cloudfront.net/*",
    "http://fi7.bot-hosting.net:22361/*",
    "http://127.0.0.1:8765/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.e3melbusiness.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "lib/hls.min.js"
  ]
}
